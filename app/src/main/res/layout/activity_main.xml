<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <TextView
        android:id="@+id/flashcard_question"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:text="Quel est le 44eme president des Etats-Unis?"
        android:textSize="40sp"
        android:gravity="center"
        android:textColor="@android:color/black"
        android:background="@drawable/card_background"
        android:elevation="5dp"
        />


    <TextView
        android:id="@+id/choice_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/flashcard_question"
        android:layout_marginTop="36dp"
        android:background="#FFDAB9"
        android:gravity="center"
        android:padding="16dp"
        android:text="Bill Clinton"
        android:textColor="#3F51B5"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/choice_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/choice_2"
        android:layout_marginTop="12dp"
        android:background="#FFDAB9"
        android:gravity="center"
        android:padding="16dp"
        android:text="Barack Obama"
        android:textColor="#3F51B5"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/choice_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/choice_1"
        android:layout_marginTop="12dp"
        android:background="#FFDAB9"
        android:gravity="center"
        android:padding="16dp"
        android:text="George H. W. Bush"
        android:textColor="#3F51B5"
        android:textSize="20sp" />
    <ImageView
        android:id="@+id/toggle_choices_visibility"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_visibility" />

</RelativeLayout>